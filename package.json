{
  "name": "ids-whatsapp-support",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp customer support and sales system: dashboard, control-plane backend, n8n workflows and PostgreSQL schema.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "staff:create": "node scripts/create-staff.mjs",
    "verify:models": "node scripts/verify-models.mjs",
    "n8n:build": "node n8n/build.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@openrouter/sdk": "^1.3.28",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
