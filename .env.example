# Copy to .env (never commit .env). Every value below stays on the server;
# nothing is exposed to the browser.

# PostgreSQL for this application (separate from n8n's own database).
# Connect as the wa_app role created by db/roles.sql.
DATABASE_URL=postgresql://wa_app:CHANGE_ME@localhost:5432/wa_support
DB_POOL_MAX=10

# Public origin of the dashboard (used for CSRF/origin checks, links in
# staff notifications and the n8n history import).
APP_ORIGIN=https://support.example.com
COOKIE_SECURE=true
SESSION_TTL_HOURS=12

# Zernio webhook signing secret (the value configured on the webhook in Zernio).
ZERNIO_WEBHOOK_SECRET=CHANGE_ME_min_16_chars

# WooCommerce webhook secret (WooCommerce > Settings > Advanced > Webhooks).
WOO_WEBHOOK_SECRET=CHANGE_ME_min_16_chars

# n8n: base URL of production webhooks and the token the backend sends in the
# X-Internal-Token header. The same token goes into the n8n Header Auth
# credential "WA Internal Token" (header name: X-Internal-Token).
N8N_WEBHOOK_BASE=https://n8n.example.com/webhook
N8N_INTERNAL_TOKEN=CHANGE_ME_min_24_chars

# Token n8n sends to the backend (history import). The same token goes into
# the n8n Header Auth credential "WA Backend Internal Token"
# (header name: X-Internal-Token).
BACKEND_INTERNAL_TOKEN=CHANGE_ME_min_24_chars

# OpenRouter key, used by the backend only for the prompt test area and
# `npm run verify:models`. n8n uses its own stored credential.
OPENROUTER_API_KEY=

# Seed defaults (read once by `npm run db:seed`; change later in the dashboard).
SHOP_NAME=Infinity Digital Shop
WOO_BASE_URL=https://infinitydigitalshop.com

# First staff account (read by `npm run staff:create`; remove afterwards).
STAFF_PASSWORD=
