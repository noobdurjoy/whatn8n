    {
      "id": "j_history-06",
      "name": "Fetch History Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://zernio.com/api/v1/inbox/conversations/' + encodeURIComponent($('History Target').first().json.provider_conversation_id) + '/messages' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "accountId",
              "value": "={{ $('History Target').first().json.provider_account_id }}"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": true
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "cursor",
                    "value": "={{ $response.body.pagination && $response.body.pagination.nextCursor }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !($response.body.pagination && $response.body.pagination.hasMore) }}",
              "limitPagesFetched": true,
              "maxRequests": 50,
              "requestInterval": 300
            }
          }
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "NAWZ1V27MYMGkozE",
          "name": "Custom Auth account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "j_history-07",
      "name": "Map History Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "jsCode": "// WA · J History Import — \"Map History Page\"\n// Input: pages of GET /v1/inbox/conversations/{id}/messages for ONE known\n// conversation (cursor pagination). Each page becomes one call to the\n// backend's /api/internal/history-import, which stores the messages as\n// historical: they are shown to staff but never routed or answered.\n\nconst t = $('History Target').first().json;\nconst out = [];\nfor (const it of $input.all()) {\n  const page = it.json && it.json.body ? it.json.body : it.json;\n  const msgs = Array.isArray(page && page.messages) ? page.messages : [];\n  const mapped = msgs.filter((m) => m && m.id && m.createdAt && (m.direction === 'incoming' || m.direction === 'outgoing')).slice(0, 100).map((m) => {\n    const att = Array.isArray(m.attachments) && m.attachments[0] ? m.attachments[0].type : null;\n    const kinds = ['image', 'audio', 'video', 'file', 'sticker', 'template'];\n    return {\n      provider_message_id: String(m.id).slice(0, 300),\n      direction: m.direction,\n      text: typeof m.message === 'string' ? m.message.slice(0, 10000) : null,\n      sent_at: m.createdAt,\n      kind: att && kinds.indexOf(att) >= 0 ? att : (typeof m.message === 'string' && m.message ? 'text' : 'unsupported'),\n    };\n  });\n  if (!mapped.length) continue;\n  out.push({ json: { body: {\n    provider_account_id: t.provider_account_id,\n    provider_conversation_id: t.provider_conversation_id,\n    participant: t.participant,\n    messages: mapped,\n  } } });\n}\nreturn out;\n"
      }
    },
    {
      "id": "j_history-08",
      "name": "Store History Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Dashboard URL').first().json.url }}/api/internal/history-import",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": null,
          "name": "WA Backend Internal Token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "j_history-09",
      "name": "Dashboard URL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        520,
        180
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT app.setting('dashboard_url') #>> '{}' AS url",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": null,
          "name": "WA Postgres (wa_n8n)"
        }
      },
      "executeOnce": true
    }
  ],
