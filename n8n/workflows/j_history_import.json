        "postgres": {
          "id": null,
          "name": "WA Postgres (wa_n8n)"
        }
      }
    },
    {
      "id": "j_history-03",
      "name": "Import Each",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
