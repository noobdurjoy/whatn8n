        "query": "SELECT o.id AS outbound_id FROM (SELECT $1::jsonb AS p) x, app.outbound_messages o\n       WHERE o.conversation_id = (p->>'c')::uuid AND o.status = 'queued' ORDER BY o.created_at LIMIT 5",
        "options": {
