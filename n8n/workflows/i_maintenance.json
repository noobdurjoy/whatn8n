      "name": "List Provider Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        720
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://zernio.com/api/v1/inbox/conversations/' + encodeURIComponent($json.provider_conversation_id) + '/messages' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
