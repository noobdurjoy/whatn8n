    {
      "id": "i_maintenance-14",
      "name": "Match Unknown Send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        540
      ],
      "parameters": {
        "jsCode": "// WA · I Maintenance — \"Match Unknown Send\"\n// Input: the conversation's recent messages from Zernio for ONE send whose\n// outcome is unknown (timeout or 5xx). Exactly one outgoing message with the\n// same text, sent after the outbox row was created, is provider evidence and\n// resolves the send as sent. Anything else is attached to the alert for a\n// person to decide; nothing is re-sent automatically.\n\nconst u = $('Unknown Send').first().json;\nconst r = $input.first().json || {};\nconst status = typeof r.statusCode === 'number' ? r.statusCode : null;\nif (r.error || status === null || status < 200 || status >= 300) {\n  return [{ json: { action: 'evidence', outbound_id: u.outbound_id, evidence: { error: 'provider_lookup_failed', http_status: status } } }];\n}\nconst body = typeof r.body === 'string' ? JSON.parse(r.body) : (r.body || {});\nconst created = Date.parse(u.created_at) - 60 * 1000;\nconst norm = (s) => String(s || '').replace(/\\s+/g, ' ').trim();\nconst want = norm(u.body);\nconst candidates = (Array.isArray(body.messages) ? body.messages : [])\n  .filter((m) => m.direction === 'outgoing' && Date.parse(m.createdAt) >= created)\n  .map((m) => ({ id: m.id, created_at: m.createdAt, same_text: want !== '' && norm(m.message) === want }));\nconst exact = candidates.filter((c) => c.same_text);\nif (exact.length === 1 && exact[0].id) {\n  return [{ json: { action: 'resolve', outbound_id: u.outbound_id, provider_message_id: exact[0].id,\n    evidence: { method: 'provider_message_list_exact_text', candidate: exact[0], checked_at: new Date().toISOString() } } }];\n}\nreturn [{ json: { action: 'evidence', outbound_id: u.outbound_id, evidence: { candidates: candidates.slice(0, 10), exact_matches: exact.length } } }];\n"
      }
    },
    {
      "id": "i_maintenance-15",
      "name": "Reconcile Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        780,
        180
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "resolve",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "resolve"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "evidence",
              "renameOutput": true,
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "evidence"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      }
    },
